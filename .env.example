# Environment configuration for music-transfer.
#
# Copy this file to `.env` and fill in only what you need. Every value below has
# a safe default in code, so an empty or absent `.env` is valid.
#
# SECURITY
#   * Never commit a real `.env`.
#   * No music-service password belongs here. OAuth sessions are stored in the
#     OS keyring; this application never asks for or stores a password.
#   * No token belongs here either. Tokens are read from the keyring at runtime.
#
# Precedence: a real environment variable always wins over the value in `.env`.

# ---------------------------------------------------------------------------
# Localization and logging
# ---------------------------------------------------------------------------
# Interface language: en or ru. Also persisted (non-secret) in config.json.
MUSIC_TRANSFER_LANGUAGE=en
# DEBUG, INFO, WARNING, ERROR
MUSIC_TRANSFER_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Where backups, reports, logs, and durable state are written.
# Relative paths are resolved against the project root.
MUSIC_TRANSFER_DATA_DIR=data

# ---------------------------------------------------------------------------
# HTTP behaviour (shared by every platform adapter)
# ---------------------------------------------------------------------------
# Per-request timeout in seconds. A slow network must not hang a transfer.
MUSIC_TRANSFER_HTTP_TIMEOUT=20
# Attempts for a *retry-safe* request. Non-idempotent writes are never retried.
MUSIC_TRANSFER_HTTP_MAX_ATTEMPTS=3
# Exponential backoff bounds, in seconds.
MUSIC_TRANSFER_BACKOFF_INITIAL=1
MUSIC_TRANSFER_BACKOFF_MAX=8

# ---------------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------------
# Page size for library sections and for playlist contents.
MUSIC_TRANSFER_PAGE_SIZE=50
MUSIC_TRANSFER_PLAYLIST_PAGE_SIZE=100
# Safety bounds. Exceeding them raises an error instead of looping forever.
# A short non-empty page is NOT treated as the end of pagination.
MUSIC_TRANSFER_MAX_PAGES=10000
MUSIC_TRANSFER_MAX_ITEMS=1000000

# ---------------------------------------------------------------------------
# Matching
# ---------------------------------------------------------------------------
# Score at or above which a match is accepted without review.
MUSIC_TRANSFER_MATCH_HIGH=0.88
# Score below which a match is reported as "not found".
MUSIC_TRANSFER_MATCH_AMBIGUOUS=0.62
# Allow fuzzy matching as a last resort (after ISRC and metadata strategies).
MUSIC_TRANSFER_MATCH_FUZZY=true
MUSIC_TRANSFER_MATCH_CANDIDATES=5

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
# Attempts per item before it is recorded as a durable failure.
MUSIC_TRANSFER_MAX_ITEM_ATTEMPTS=3
# Persist item state after every item, which is what makes resume exact.
MUSIC_TRANSFER_CHECKPOINT_EVERY_ITEM=true
# Verify the destination against the plan after execution.
MUSIC_TRANSFER_VERIFY=true

# ---------------------------------------------------------------------------
# Feature flags (all OFF: see docs/roadmap.md for the plan)
# ---------------------------------------------------------------------------
# Telegram interface - interface layer only, no transfer logic.
MUSIC_TRANSFER_FEATURE_TELEGRAM=false
# Queue/worker execution (Redis/Celery/Dramatiq) - not implemented.
MUSIC_TRANSFER_FEATURE_WORKERS=false
# PostgreSQL persistence behind the repository ports - not implemented.
MUSIC_TRANSFER_FEATURE_POSTGRES=false

# Placeholders for capabilities that do not exist yet. They are documented so
# no one is tempted to invent a fake adapter: an unimplemented platform raises
# UnsupportedCapabilityError rather than pretending to work.
# MUSIC_TRANSFER_SPOTIFY_CLIENT_ID=
# MUSIC_TRANSFER_SPOTIFY_CLIENT_SECRET=
# MUSIC_TRANSFER_TELEGRAM_BOT_TOKEN=
# MUSIC_TRANSFER_DATABASE_URL=
